# ============================================================
#  INDIQUE E GANHE - Configuração
#  Copie para .env e preencha os valores
# ============================================================

# Gere uma chave segura com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=coloque-uma-chave-segura-aqui

# Porta do servidor (padrão 5000)
PORT=5000

# 1 = modo debug (não usar em produção)
FLASK_DEBUG=0

# Tentativas de login antes do rate limit
MAX_LOGIN_ATTEMPTS=10
# Janela do rate limit em segundos (login e register)
RATE_LIMIT_WINDOW=60

# Valor mínimo para saque (R$)
MIN_PAYOUT=10

# Origem CORS permitida. Deixe vazio para mesma origem (recomendado).
# Use '*' para qualquer origem (inseguro) ou URL específica.
CORS_ORIGIN=

# ── SMTP ────────────────────────────────────────────────────
# Deixe SMTP_HOST vazio para simular envio no console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@indiqueeganhe.com.br

# Webhook disparado a cada conversão
CONVERSION_WEBHOOK=

# 1 = desabilita a rota /api/seed (recomendado em produção)
DISABLE_SEED=1

# 1 = GET /api/affiliates público (sem email/telefone/saldo)
PUBLIC_AFFILIATES=1
